-- Lógica de arrasto do slider
local function setupSliderDrag(slider, minVal, maxVal, onChange)
    local dragging = false

    local function updateFromX(xPos)
        local trackSize = slider.track.AbsoluteSize.X
        local relX = math.clamp((xPos - slider.track.AbsolutePosition.X) / trackSize, 0, 1)
        slider.fill.Size = UDim2.new(relX, 0, 1, 0)
        slider.knob.Position = UDim2.new(relX, -9, 0.5, -9)
        local newVal = minVal + (maxVal - minVal) * relX
        slider.value = newVal
        slider.label.Text = string.gsub(slider.label.Text, ": [%.%d]+x", ": " .. string.format("%.1f", newVal) .. "x")
        onChange(newVal)
    end

    slider.knob.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end)

    slider.track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            updateFromX(input.Position.X)
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            updateFromX(input.Position.X)
        end
    end)
end

-- Draggable da UI
local dragging, dragInput, dragStart, startPos

titleBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = mainFrame.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then dragging = false end
        end)
    end
end)

titleBar.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        local delta = input.Position - dragStart
        mainFrame.Position = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + delta.X, 
            startPos.Y.Scale, startPos.Y.Offset + delta.Y
        )
    end
end)

-- Lógica de esticamento (replica pros outros jogadores)
local character = player.Character or player.CharacterAdded:Wait()
local humanoid = character:WaitForChild("Humanoid")

local function getScale(name)
    local s = humanoid:FindFirstChild(name)
    if not s then
        s = Instance.new("NumberValue")
        s.Name = name
        s.Value = 1
        s.Parent = humanoid
    end
    return s
end

local heightScale = getScale("BodyHeightScale")
local widthScale = getScale("BodyWidthScale")
local depthScale = getScale("BodyDepthScale")
local headScale = getScale("HeadScale")

local originalHeight = heightScale.Value
local originalWidth = widthScale.Value
local originalDepth = depthScale.Value
local originalHead = headScale.Value
local originalHipHeight = humanoid.HipHeight

local function applyStretch()
    heightScale.Value = heightSlider.value
    widthScale.Value = widthSlider.value
    depthScale.Value = depthSlider.value
    headScale.Value = heightSlider.value -- cabeça acompanha a altura
    
    -- Ajusta o HipHeight pra não ficar flutuando ou enterrado
    humanoid.HipHeight = originalHipHeight * heightSlider.value
end

local function applyNormal()
    heightScale.Value = originalHeight
    widthScale.Value = originalWidth
    depthScale.Value = originalDepth
    headScale.Value = originalHead
    humanoid.HipHeight = originalHipHeight
    
    -- Reseta sliders pra 1.0
    heightSlider.value = 1.0
    widthSlider.value = 1.0
    depthSlider.value = 1.0
    heightSlider.fill.Size = UDim2.new(0.25, 0, 1, 0)
    widthSlider.fill.Size = UDim2.new(0.25, 0, 1, 0)
    depthSlider.fill.Size = UDim2.new(0.25, 0, 1, 0)
    heightSlider.knob.Position = UDim2.new(0.25, -9, 0.5, -9)
    widthSlider.knob.Position = UDim2.new(0.25, -9, 0.5, -9)
    depthSlider.knob.Position = UDim2.new(0.25, -9, 0.5, -9)
    heightSlider.label.Text = "Altura: 1.0x"
    widthSlider.label.Text = "Largura: 1.0x"
    depthSlider.label.Text = "Profundidade: 1.0x"
end

stretchBtn.MouseButton1Click:Connect(applyStretch)
normalBtn.MouseButton1Click:Connect(applyNormal)

setupSliderDrag(heightSlider, 0.5, 5, applyStretch)
setupSliderDrag(widthSlider, 0.5, 5, applyStretch)
setupSliderDrag(depthSlider, 0.5, 5, applyStretch)

-- Reaplica se o character respawnar
player.CharacterAdded:Connect(function(newChar)
    character = newChar
